---
interface Props {
  title: string;
  description: string;
  meta?: string;
  thumbSrc?: string;
  thumbAlt?: string;
  dialogId: string;
}
const { title, description, meta, thumbSrc, thumbAlt = "", dialogId } = Astro.props;
---

<article class="card">
  <button type="button" data-modal-open={dialogId} aria-haspopup="dialog">
    {
      thumbSrc && (
        <span class="thumb">
          <img src={thumbSrc} alt={thumbAlt} loading="lazy" width="1440" height="900" />
        </span>
      )
    }
    <span class="body">
      <span class="title">{title}</span>
      <span class="desc">{description}</span>
      {meta && <span class="meta">{meta}</span>}
    </span>
  </button>
</article>

<style>
  .card button {
    display: block;
    width: 100%;
    padding: 0;
    font: inherit;
    text-align: left;
    color: inherit;
    cursor: pointer;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  .card button:hover {
    border-color: var(--text-muted);
  }
  @media (prefers-reduced-motion: no-preference) {
    .card button {
      transition: border-color 0.15s ease, transform 0.15s ease;
    }
    .card button:hover {
      transform: translateY(-2px);
    }
  }

  .thumb {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
  }
  .title {
    font-size: var(--step-1);
    font-weight: 650;
    line-height: var(--leading-tight);
    letter-spacing: -0.02em;
  }
  .desc {
    font-size: var(--step-0);
    color: var(--text-muted);
  }
  .meta {
    margin-top: var(--space-2);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }
</style>
