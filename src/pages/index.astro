---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SiteModal from "../components/SiteModal.astro";

const positioning =
  'Design engineer with a UI/UX design and full-stack development background. I design in Figma, build in React, and use an AI pipeline to keep the two in sync.';
---

<Base title="Cansın Bayır — UI/UX · Design Engineer" description={positioning}>
  <main>
    <header class="hero">
      <p class="tag">Portfolio</p>
      <h1>Cansın Bayır</h1>
      <p class="lead">{positioning}</p>
    </header>

    <section class="work" aria-labelledby="work-heading">
      <h2 id="work-heading">Selected Work</h2>
      <div class="grid">
        <ProjectCard
          title="Law firm website"
          description="A website for a law firm, designed and built solo for a real client."
          meta="tinashukuk.com · Live"
          thumbSrc="/assets/tinas-hukuk/home-desktop.png"
          thumbAlt="Homepage of the Tınaş Hukuk law firm website"
          dialogId="tinas-modal"
        />
        <ProjectCard
          title="Period tracker"
          description="A period tracker transmasculine users can actually use: inclusive language, no gender-coded assumptions, privacy first."
          meta="Case study · Live demos inside"
          thumbSrc="/assets/period-tracker/case-study-hero.png"
          thumbAlt="Opening of the period tracker UX case study — 'A survey of what 37 people couldn't find in period apps'"
          dialogId="period-modal"
        />
        <ProjectCard
          title="Planting planner"
          description="A phone-first map for a real landowner: sketch what to plant on 102 dönüm and see what it costs."
          meta="Case study · Live demo inside"
          thumbSrc="/assets/kilya/overview-desktop.webp"
          thumbAlt="The planting planner in edit mode: a gridded field on satellite imagery with the olive area selected and the crop panel open"
          dialogId="kilya-modal"
        />
      </div>
    </section>
  </main>

  <SiteModal
    id="tinas-modal"
    url="https://tinashukuk.com"
    title="Tınaş Hukuk — live site preview"
  />
  <SiteModal
    id="period-modal"
    url="/work/period-tracker/"
    label="cansinbayir.com/work/period-tracker"
    title="Period tracker — UX case study with live demos"
  />
  <SiteModal
    id="kilya-modal"
    url="/work/kilya"
    label="cansinbayir.com/work/kilya"
    title="Planting planner — UX case study with live demo"
  />
</Base>

<style>
  main {
    max-width: var(--measure);
    margin-inline: auto;
    padding: var(--space-16) var(--space-6) var(--space-24);
  }

  .tag {
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }
  h1 {
    font-size: var(--step-4);
    margin-bottom: var(--space-4);
  }
  .lead {
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .work {
    margin-top: var(--space-16);
  }
  h2 {
    font-size: var(--step-3);
    margin-bottom: var(--space-6);
  }
  .grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
</style>
